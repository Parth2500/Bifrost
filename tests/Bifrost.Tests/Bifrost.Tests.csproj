<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Bifrost.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageReference Include="CsCheck" Version="5.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Bifrost.Core/Bifrost.Core.csproj" />
    <ProjectReference Include="../../src/Bifrost.Client/Bifrost.Client.csproj" />
    <ProjectReference Include="../../src/Bifrost.Server/Bifrost.Server.csproj" />
    <ProjectReference Include="../../src/Bifrost.App/Bifrost.App.csproj" />
    <!-- Built beside the tests, not referenced: the tests start it as a child process. -->
    <ProjectReference Include="../Bifrost.FakeExtension/Bifrost.FakeExtension.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
