<?xml version="1.0" encoding="utf-8"?>
<!-- Flat tonal fill with a one-pixel lit top edge: the contract's "glass", with no blur or gradient. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item><shape android:shape="rectangle"><solid android:color="@color/bifrost_edge"/><corners android:radius="16dp"/></shape></item>
  <item android:top="1dp"><shape android:shape="rectangle"><solid android:color="@color/bifrost_section"/><corners android:radius="16dp"/></shape></item>
</layer-list>
