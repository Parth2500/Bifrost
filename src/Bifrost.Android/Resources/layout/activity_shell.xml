<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shell_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bifrost_ground">
  <com.google.android.material.appbar.AppBarLayout android:id="@+id/appbar" android:layout_width="match_parent"
      android:layout_height="wrap_content" android:background="@color/bifrost_teal" app:liftOnScroll="false">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent"
        android:layout_height="64dp" android:background="@color/bifrost_teal" android:paddingStart="16dp"
        android:theme="@style/ThemeOverlay.Bifrost.Bar" app:popupTheme="@style/Theme.Bifrost">
      <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical">
        <ImageView android:layout_width="wrap_content" android:layout_height="40dp" android:src="@drawable/bifrost_mark"
            android:importantForAccessibility="no" android:adjustViewBounds="true"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="12dp" android:orientation="vertical">
          <TextView android:id="@+id/bar_home" android:layout_width="match_parent" android:layout_height="wrap_content"
              android:textAppearance="?attr/textAppearanceTitleMedium" android:textColor="@color/bifrost_ink" android:singleLine="true"/>
          <TextView android:id="@+id/bar_area" android:layout_width="match_parent" android:layout_height="wrap_content"
              android:textAppearance="?attr/textAppearanceBodySmall" android:textColor="@color/bifrost_bar_text_2" android:singleLine="true"/>
        </LinearLayout>
        <FrameLayout android:id="@+id/bar_arcs" android:layout_width="40dp" android:layout_height="24dp" android:layout_marginEnd="4dp"/>
      </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/progress"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true"
        android:visibility="invisible" app:trackThickness="3dp" app:indicatorColor="@color/bifrost_ink" app:trackColor="@color/bifrost_teal"/>
  </com.google.android.material.appbar.AppBarLayout>
  <FrameLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <LinearLayout android:id="@+id/unreachable" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center" android:padding="32dp" android:visibility="gone"
        android:background="@color/bifrost_ground">
      <FrameLayout android:id="@+id/unreachable_arcs" android:layout_width="64dp" android:layout_height="36dp" android:layout_marginBottom="16dp"/>
      <TextView android:id="@+id/unreachable_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
          android:textAppearance="?attr/textAppearanceTitleLarge" android:textColor="?attr/colorOnSurface" android:gravity="center"/>
      <TextView android:id="@+id/unreachable_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
          android:textAppearance="?attr/textAppearanceBodyMedium" android:textColor="?attr/colorOnSurface" android:gravity="center"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/retry" android:layout_width="wrap_content"
          android:layout_height="56dp" android:layout_marginTop="24dp" android:text="Try again"/>
    </LinearLayout>
  </FrameLayout>
  <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/nav" android:saveEnabled="false" android:layout_width="match_parent"
      android:layout_height="wrap_content" app:menu="@menu/nav" android:background="@color/bifrost_nav"
      app:itemTextColor="@color/nav_text" app:itemIconTint="@color/nav_item"
      app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator"/>
</LinearLayout>
