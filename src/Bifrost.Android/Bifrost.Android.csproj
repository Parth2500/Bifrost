<Project Sdk="Microsoft.NET.Sdk">

  <!-- Not in Bifrost.slnx: it needs the Android workload and SDK. Build it with
       dotnet build src/Bifrost.Android -p:AndroidSdkDirectory=$HOME/Android/Sdk -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <ApplicationId>org.bifrost.client</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <RootNamespace>Bifrost.Android</RootNamespace>
    <!-- The generated Android code is not ours to keep warning-free. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- A debug APK installed by hand has no tool to push its assemblies, and dies at launch without this. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Bifrost.Client/Bifrost.Client.csproj" />
  </ItemGroup>

</Project>
